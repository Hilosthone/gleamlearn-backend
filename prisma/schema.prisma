datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String    @id @default(uuid())
  fullName              String
  username              String    @unique
  email                 String    @unique
  passwordHash          String
  dateOfBirth           DateTime?
  country               String?
  educationType         String?
  institution           String?
  department            String?
  levelOrClass          String?
  preferredLearningPace String?   @default("moderate")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("users")
}